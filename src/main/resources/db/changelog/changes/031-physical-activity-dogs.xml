<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="031-physical-activity-dogs" author="oskott">
        <createTable tableName="physical_activity_dogs">
            <column name="activity_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_physical_activity_dogs_activity" references="physical_activities(id)"/>
            </column>
            <column name="dog_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_physical_activity_dogs_dog" references="dogs(id)" deleteCascade="true"/>
            </column>
            <column name="list_index" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_physical_activity_dogs_activity_id" tableName="physical_activity_dogs">
            <column name="activity_id"/>
        </createIndex>
        <createIndex indexName="idx_physical_activity_dogs_dog_id" tableName="physical_activity_dogs">
            <column name="dog_id"/>
        </createIndex>

        <sql>
            INSERT INTO physical_activity_dogs (activity_id, dog_id, list_index)
            SELECT id, dog_id, 0 FROM physical_activities
        </sql>

        <dropIndex indexName="idx_physical_activities_dog_id" tableName="physical_activities"/>
        <dropForeignKeyConstraint baseTableName="physical_activities" constraintName="fk_physical_activities_dog"/>
        <dropColumn tableName="physical_activities" columnName="dog_id"/>
    </changeSet>

</databaseChangeLog>
