<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="003-create-dogs" author="oskott">
        <createTable tableName="dogs">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="owner_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_dogs_owner" references="users(id)"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="breed" type="VARCHAR(255)"/>
            <column name="birth_date" type="DATE"/>
            <column name="sex" type="VARCHAR(20)"/>
            <column name="weight" type="DECIMAL(6,2)"/>
            <column name="image_url" type="VARCHAR(1024)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_dogs_owner_id" tableName="dogs">
            <column name="owner_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
