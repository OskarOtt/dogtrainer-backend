<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="006-create-training-sessions" author="oskott">
        <createTable tableName="training_sessions">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="dog_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_training_sessions_dog" references="dogs(id)"/>
            </column>
            <column name="started_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="completed_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="duration_minutes" type="INT"/>
            <column name="location" type="VARCHAR(255)"/>
            <column name="notes" type="VARCHAR(2048)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_training_sessions_dog_id" tableName="training_sessions">
            <column name="dog_id"/>
        </createIndex>

        <createTable tableName="session_exercises">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="session_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_session_exercises_session" references="training_sessions(id)"/>
            </column>
            <column name="exercise_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_session_exercises_exercise" references="exercises(id)"/>
            </column>
            <column name="repetitions" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="successful_repetitions" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="difficulty" type="VARCHAR(20)"/>
            <column name="notes" type="VARCHAR(2048)"/>
        </createTable>
        <createIndex indexName="idx_session_exercises_session_id" tableName="session_exercises">
            <column name="session_id"/>
        </createIndex>
        <createIndex indexName="idx_session_exercises_exercise_id" tableName="session_exercises">
            <column name="exercise_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
