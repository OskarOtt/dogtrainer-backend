<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="032-post-dogs" author="oskott">
        <createTable tableName="post_dogs">
            <column name="post_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_post_dogs_post" references="posts(id)"/>
            </column>
            <column name="dog_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_post_dogs_dog" references="dogs(id)" deleteCascade="true"/>
            </column>
            <column name="list_index" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_post_dogs_post_id" tableName="post_dogs">
            <column name="post_id"/>
        </createIndex>
        <createIndex indexName="idx_post_dogs_dog_id" tableName="post_dogs">
            <column name="dog_id"/>
        </createIndex>

        <sql>
            INSERT INTO post_dogs (post_id, dog_id, list_index)
            SELECT id, dog_id, 0 FROM posts WHERE dog_id IS NOT NULL
        </sql>

        <dropForeignKeyConstraint baseTableName="posts" constraintName="fk_posts_dog"/>
        <dropColumn tableName="posts" columnName="dog_id"/>
    </changeSet>

</databaseChangeLog>
