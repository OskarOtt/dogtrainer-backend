<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="009-add-training-plan-exercises" author="oskott">
        <createTable tableName="training_plan_exercises">
            <column name="plan_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_training_plan_exercises_plan"
                             references="training_plans(id)"/>
            </column>
            <column name="exercise_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_training_plan_exercises_exercise"
                             references="exercises(id)"/>
            </column>
            <column name="list_index" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_training_plan_exercises_plan_id" tableName="training_plan_exercises">
            <column name="plan_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
