<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="018-create-blocks" author="oskott">
        <createTable tableName="blocks">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="blocker_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_blocks_blocker" references="users(id)"/>
            </column>
            <column name="blocked_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_blocks_blocked" references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="blocks" columnNames="blocker_id, blocked_id" constraintName="uq_blocks_blocker_blocked"/>
        <createIndex indexName="idx_blocks_blocker_id" tableName="blocks">
            <column name="blocker_id"/>
        </createIndex>
        <createIndex indexName="idx_blocks_blocked_id" tableName="blocks">
            <column name="blocked_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
