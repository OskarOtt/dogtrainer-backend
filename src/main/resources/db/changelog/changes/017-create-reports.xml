<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="017-create-reports" author="oskott">
        <createTable tableName="reports">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="reporter_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_reports_reporter" references="users(id)"/>
            </column>
            <column name="post_id" type="UUID">
                <constraints foreignKeyName="fk_reports_post" references="posts(id)" deleteCascade="true"/>
            </column>
            <column name="reported_user_id" type="UUID">
                <constraints foreignKeyName="fk_reports_reported_user" references="users(id)"/>
            </column>
            <column name="reason" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="details" type="VARCHAR(1024)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_reports_reporter_id" tableName="reports">
            <column name="reporter_id"/>
        </createIndex>
        <createIndex indexName="idx_reports_post_id" tableName="reports">
            <column name="post_id"/>
        </createIndex>
        <createIndex indexName="idx_reports_reported_user_id" tableName="reports">
            <column name="reported_user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
