<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="019-create-post-likes" author="oskott">
        <createTable tableName="post_likes">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="post_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_post_likes_post" references="posts(id)"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_post_likes_user" references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="post_likes" columnNames="post_id, user_id" constraintName="uq_post_likes_post_user"/>
        <createIndex indexName="idx_post_likes_post_id" tableName="post_likes">
            <column name="post_id"/>
        </createIndex>
        <createIndex indexName="idx_post_likes_user_id" tableName="post_likes">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
