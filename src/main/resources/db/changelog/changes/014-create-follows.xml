<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="014-create-follows" author="oskott">
        <createTable tableName="follows">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="follower_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_follows_follower" references="users(id)"/>
            </column>
            <column name="followee_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_follows_followee" references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="follows" columnNames="follower_id, followee_id" constraintName="uq_follows_follower_followee"/>
        <createIndex indexName="idx_follows_follower_id" tableName="follows">
            <column name="follower_id"/>
        </createIndex>
        <createIndex indexName="idx_follows_followee_id" tableName="follows">
            <column name="followee_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
