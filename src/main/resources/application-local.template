# Local development profile — in-memory H2, no external services required.
spring.datasource.url=jdbc:h2:mem:dogtrainer;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
spring.datasource.driver-class-name=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=

spring.h2.console.enabled=true
spring.h2.console.path=/h2-console

spring.liquibase.enabled=true

JWT_SECRET=dev-only-dummy-secret-0123456789abcdef

# Social sign-in. Apple private key accepts PEM text with newlines escaped as \n.
APPLE_CLIENT_IDS=com.oskar.ott.dogtrainerapp
APPLE_CLIENT_ID=com.oskar.ott.dogtrainerapp
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-sign-in-key-id
APPLE_PRIVATE_KEY=

# Dummy R2 values so the app boots without real Cloudflare credentials.
# Override with real values (see README) to actually exercise upload endpoints locally.
R2_ENDPOINT=https://dev-only-dummy.r2.cloudflarestorage.com
R2_ACCESS_KEY=dev-only-dummy-access-key
R2_SECRET_KEY=dev-only-dummy-secret-key
R2_BUCKET=dev-only-dummy-bucket
R2_PUBLIC_BASE_URL=https://dev-only-dummy.example.com